<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Google apps for KosherFlip (used when WITH_GMS=true).
  MindTheGapps "baklava" = Android 16. Google apps are proprietary: personal
  builds are fine, but distributing images that contain them needs a licence
  from Google. KosherGuard hides every Google app that is not allow-listed.
-->
<manifest>
  <remote name="mtg" fetch="https://gitlab.com/MindTheGapps/" />
  <project path="vendor/gapps" name="vendor_gapps" remote="mtg" revision="baklava" clone-depth="1" />
</manifest>
